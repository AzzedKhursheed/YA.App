<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="YA.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:YA.App.Pages"
    Title="YA.App">

    <ShellContent
        Title="Dashboard"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Yusuf's Page"
        ContentTemplate="{DataTemplate pages:YusufHomePage}"
        Route="YusufHomePage" />

    <ShellContent
     Title="Huzaifa's Page"
     ContentTemplate="{DataTemplate pages:HuzaifaHomePage}"
     Route="YusufHomePage" />

</Shell>
