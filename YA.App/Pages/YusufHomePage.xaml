<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:YA.App.Resources.Converters"
             xmlns:vm="clr-namespace:YA.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="YA.App.Pages.YusufHomePage"
             Title="YusufHomePage">

    <ContentPage.BindingContext>
        <vm:YusufHomePageViewModel />
    </ContentPage.BindingContext>

    <!-- Declare the resources for the page -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="15" BackgroundColor="MidnightBlue" Margin="5">
                
                <!-- Profile Section -->
                <Frame BackgroundColor="Teal" CornerRadius="10" Padding="10">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="{Binding Bio.ProfilePicture}" HeightRequest="100" WidthRequest="100">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Bio.ShowImagePopupCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <VerticalStackLayout>
                            <Label Text="{Binding Bio.Name}" FontSize="Title" FontAttributes="Bold" />
                            <Label Text="{Binding Bio.Age}" FontSize="16" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Bio Section -->
                <Frame Padding="15" Margin="10" CornerRadius="10">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="DarkSlateGray" Offset="0.0" />
                            <GradientStop Color="Teal" Offset="1.0" />
                        </LinearGradientBrush>
                    </Frame.Background>
                    <!-- Bio Display or Editor -->
                    <ContentView>
                        <ContentView.Resources>
                            <Style TargetType="Editor">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="TextColor" Value="White"/>
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                            </Style>
                            <ResourceDictionary>
                            </ResourceDictionary>
                        </ContentView.Resources>

                        <Grid>
                            <!-- Viewing Mode -->
                            <Label Text="{Binding Bio.Bio}"
                               IsVisible="{Binding Bio.IsEditing, Converter={StaticResource InverseBoolConverter}}"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="FillAndExpand"
                               TextColor="White" /> 

                            <!-- Editing Mode -->
                            <Editor Text="{Binding Bio.Bio}"
                                IsVisible="{Binding Bio.IsEditing}"
                                AutoSize="TextChanges"
                                BackgroundColor="DarkViolet"
                                HorizontalOptions="FillAndExpand"
                                TextColor="White" />    
                        </Grid>
                    </ContentView>
                </Frame>

                <!-- Actions Section -->
                <Button Text="Edit" Command="{Binding Bio.EditCommand}" BackgroundColor="LightBlue" TextColor="Black" />
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Image Popup Overlay -->
        <Grid IsVisible="{Binding Bio.IsImagePopupVisible}"
              BackgroundColor="#80000000"
              ZIndex="1">
            <Frame VerticalOptions="Center"
                   HorizontalOptions="Center"
                   CornerRadius="12"
                   Padding="5"
                   BackgroundColor="White"
                   BorderColor="DarkGray"
                   HasShadow="True">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Enlarged Image -->
                    <Image Source="{Binding Bio.ProfilePicture}"
                           HeightRequest="300"
                           WidthRequest="300"
                           Aspect="AspectFit"
                           Grid.Row="0" />
                    
                    <!-- Close Button -->
                    <Button Text="Close"
                            Command="{Binding Bio.ShowImagePopupCommand}"
                            Grid.Row="1"
                            BackgroundColor="Red"
                            TextColor="White"
                            CornerRadius="5"
                            Margin="10,0,10,10" />
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
